{
  "name": "real-estate-voice-agent",
  "version": "1.0.0",
  "description": "Ultra-low-latency Inbound Telephony Voice AI Agent (clone of VaniAgent) for Bangalore real estate market",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:sim": "tsx tests/simulate_calls.ts",
    "test:workflow": "tsx scripts/test-full-workflow.ts",
    "test:prod": "TEST_URL=https://getmoreos-voice-agent.vercel.app tsx scripts/test-full-workflow.ts",
    "stress:overnight": "tsx scripts/overnight_runner.ts"
  },
  "keywords": [
    "voice-ai",
    "telephony",
    "twilio",
    "exotel",
    "deepgram",
    "sarvam",
    "groq",
    "real-estate"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepgram/sdk": "^5.14.0",
    "@fastify/websocket": "^11.3.4",
    "@msgly/exotel-voice": "^1.11.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "googleapis": "^185.0.0",
    "groq-sdk": "^1.6.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
