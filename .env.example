# Server Configuration
PORT=3001
HOST=localhost:3001
PUBLIC_DOMAIN=your-production-domain.up.railway.app

# Admin Portal Authentication & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SECRET_TOKEN=your_strong_random_admin_token_here

# Telephony Configuration (Plivo - Production Enterprise Telephony)
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=MANXXXXXXXXXXXXXXXXX
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+9180XXXXXXXX
PLIVO_APP_ID=your_plivo_app_id_here

# Voice AI & Multilingual Pipeline Services
# PRIMARY LLM: Groq qwen/qwen3.8-27b (ultra-low latency ~180-250ms, fluent English/Hindi/Hinglish)
GROQ_API_KEY=your_groq_api_key_here

# PRIMARY TTS & STT: Sarvam AI Indic Voice Stack
# - TTS: Bulbul v4-flash with Simran Bilingual enhi female voice (Priya)
# - STT: Saaras v3 with auto-detect (English, Hindi, Hinglish)
SARVAM_API_KEY=your_sarvam_api_key_here

# FALLBACK LLM: OpenRouter (meta-llama/llama-3.3-70b-instruct)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OPTIONAL STT: Deepgram Nova-2 (en-IN, 8kHz mulaw)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Lead Registration Email (appears in Google Sheets and CSV exports)
LEAD_EMAIL=niraj@mittal.com

# Google Sheets Integration (Service Account)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
