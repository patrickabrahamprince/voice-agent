# Server Configuration
PORT=3001
HOST=localhost:3001
PUBLIC_DOMAIN=your-production-domain.up.railway.app

# Admin Security — set a strong random token to protect /api/* and /admin routes
ADMIN_SECRET_TOKEN=your_strong_random_admin_token_here

# Telephony Configuration (Plivo - Production Enterprise Telephony)
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=MAMXXXXXXXXXXXXXXXXX
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+9180XXXXXXXX

# Voice AI Services
# PRIMARY LLM: Groq llama-3.3-70b-versatile (free tier, ultra-low latency, 131k context)
GROQ_API_KEY=your_groq_api_key_here
# FALLBACK LLM/TTS: Sarvam AI Indic Voice Stack (used if Groq unavailable)
SARVAM_API_KEY=your_sarvam_api_key_here
# FALLBACK LLM: OpenRouter LLaMA 3.3 70B
OPENROUTER_API_KEY=your_openrouter_api_key_here
# STT: Deepgram Nova-2 (en-IN, 8kHz mulaw)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Lead Registration Email (appears in Google Sheets and CSV exports)
LEAD_EMAIL=your_lead_email@example.com

# Google Sheets Integration (Service Account)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
